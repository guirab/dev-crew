# Copy to crew.toml (not versioned) and adjust.

[nats]
url = "nats://127.0.0.1:4222"

[gateway]
host = "127.0.0.1"
port = 8787

[workspace]
root = "C:/Users/guilh/.dev-crew/worktrees"
mode = "worktree"            # "worktree" | "inplace"
# projects_dir = "C:/Users/guilh/Documents"   # where the "Novo projeto" (New project) card creates the folder when you don't say

[limits]
max_test_attempts = 3        # consecutive test failures before escalating
max_review_rounds = 2
# no cost or time cap; an agent with no activity for 30 min escalates on its own

[parallel]
workers_per_agent = 3        # how many epics can have an agent working at the same time

[models]
interviewer = "claude-sonnet-5-5"
planner     = "claude-opus-5-5"
developer   = "claude-sonnet-5-5"
tester      = "claude-sonnet-5-5"
reviewer    = "claude-opus-5-5"

[commit]
language = "pt-BR"
style = "conventional"

[[repos]]
name = "sample-repo"
path = "C:/Users/guilh/Documents/dev-crew/fixtures/sample-repo"
base_branch = "main"
test_cmd = "python -m pytest -q"
lint_cmd = ""
test_globs = ["tests/**", "**/test_*.py"]
# Optional:
# setup_cmd = "npm install"     # run by dev-crew (never by the agents) before the 1st agent and again when the Developer changes a manifest; if it fails, the task fails. Prefer `npm install` over `npm ci` (the lockfile gets out of date)
# sandbox_image = "node:22"     # agent commands run in one container per task (no network, sees only the worktree)
# deps_dirs = ["node_modules"]  # with sandbox: kept in Docker volumes, outside the worktree
# Projects created by the "Novo projeto" card live in ~/.dev-crew/repos.toml (no need to repeat them here).
